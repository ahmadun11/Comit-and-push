rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Test connection document
    match /test/connection {
      allow read: if true;
    }

    // Public lookup for username to email mapping
    match /app_users/{userDoc} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn() && (resource == null || request.auth.uid == resource.data.uid);
    }

    // User data collections - matches root user doc and ALL subcollections
    // (servis, kas, sparepart, jual_beli, karyawan, laporan_tutup_buku, settings, deletions)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
